<Project>
  <!--
    Nombre y versión del producto: ÚNICA fuente de verdad.
    El código lo lee en tiempo de ejecución con AssemblyProductAttribute (ver AppInfo.cs),
    así que para renombrar el producto basta con cambiar <Product> aquí.
  -->
  <PropertyGroup>
    <Product>OptimaPC</Product>
    <Version>0.1.0</Version>
    <Authors>OptimaPC contributors</Authors>
    <Copyright>Copyright (c) 2026 OptimaPC contributors</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Símbolos dentro de cada ensamblado: no hay .pdb sueltos en el paquete publicado. -->
    <DebugType>embedded</DebugType>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <SatelliteResourceLanguages>en;es</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
