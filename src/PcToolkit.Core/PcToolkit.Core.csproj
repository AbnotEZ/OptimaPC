<Project Sdk="Microsoft.NET.Sdk">
  <!-- Núcleo sin dependencias de Windows: modelos, interpretación, sesiones, exportación,
       persistencia de historial y presentación. Se prueba sin tocar el sistema real. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PcToolkit.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- WithCulture=false: sin esto, MSBuild interpreta ".es"/".en" como cultura y mueve los textos
         a ensamblados satélite, y Loc no los encuentra en la DLL principal. -->
    <EmbeddedResource Include="Localization\Strings.*.json" LogicalName="PcToolkit.Strings.%(Filename).json" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PcToolkit.Core.Tests" />
  </ItemGroup>
</Project>
