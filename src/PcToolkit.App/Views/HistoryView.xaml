<UserControl x:Class="PcToolkit.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:PcToolkit.App">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="{app:Tr Nav.History}" />
            <Border Style="{StaticResource Notice}">
                <TextBlock Style="{StaticResource Body}" Text="{app:Tr History.RestoreNote}" />
            </Border>
            <TextBlock Style="{StaticResource Muted}" Text="{Binding Limits}" />
            <WrapPanel Margin="0,10,0,8">
                <Button Content="{app:Tr History.Open}" Command="{Binding OpenCommand}" Padding="14,6" Margin="0,0,8,6" />
                <Button Content="{app:Tr History.Delete}" Command="{Binding DeleteCommand}" Padding="14,6" Margin="0,0,8,6" />
                <Button Content="{app:Tr History.DeleteAll}" Command="{Binding DeleteAllCommand}" Padding="14,6" Margin="0,0,8,6" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Body}" Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <ListView ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Margin="0,8,0,0"
                  AutomationProperties.Name="{app:Tr Nav.History}" MaxWidth="980" HorizontalAlignment="Left">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding When}" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4">
                        <TextBlock Text="{Binding When}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Details}" Opacity="0.78" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </DockPanel>
</UserControl>
