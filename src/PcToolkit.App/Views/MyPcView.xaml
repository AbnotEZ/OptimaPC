<UserControl x:Class="PcToolkit.App.Views.MyPcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:PcToolkit.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="8" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="{app:Tr Nav.MyPc}" />
            <TextBlock Style="{StaticResource Body}" Text="{Binding Header}" />
            <WrapPanel Margin="0,8,0,12">
                <Button Content="{app:Tr MyPc.Read}" Command="{Binding ReadCommand}" Padding="14,6" />
                <TextBlock Text="{Binding Status}" Margin="12,0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Muted}" Text="{app:Tr MyPc.Legend}" Margin="0,0,0,12" />

            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="240" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Opacity="0.78" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                    <Setter Property="FontStyle" Value="Italic" />
                                                                    <Setter Property="Opacity" Value="0.8" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Note}" Margin="0,8,0,0" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Expander Header="{app:Tr Common.TechnicalDetails}" Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2">
                                                    <TextBlock TextWrapping="Wrap" FontSize="12">
                                                        <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <Run Text=" — " />
                                                        <Run Text="{Binding Source, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBox Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                                             TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="12,0,0,0">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
