<Window x:Class="PcToolkit.App.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:PcToolkit.App"
        Title="{app:Tr Export.Title}" Width="900" Height="680" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource Body}" Text="{app:Tr Export.Intro}" />
            <WrapPanel Margin="0,10,0,6">
                <RadioButton Content="JSON" IsChecked="{Binding AsJson}" GroupName="fmt" Margin="0,0,16,6" />
                <RadioButton Content="{app:Tr Export.Text}" GroupName="fmt" Margin="0,0,24,6" />
                <CheckBox Content="{app:Tr Export.IncludeProcesses}" IsChecked="{Binding IncludeProcesses}" IsEnabled="{Binding HasSession}" Margin="0,0,16,6" />
                <CheckBox Content="{app:Tr Export.IncludeStartup}" IsChecked="{Binding IncludeStartupCommands}" Margin="0,0,16,6" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Muted}" Text="{app:Tr Export.StartupWarning}" />
            <TextBlock Style="{StaticResource SectionTitle}" Text="{app:Tr Export.Preview}" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <Button DockPanel.Dock="Right" Content="{app:Tr Common.Close}" IsCancel="True" Padding="16,6" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="{app:Tr Export.SaveAs}" Command="{Binding SaveCommand}" Padding="16,6" Style="{DynamicResource AccentButtonStyle}" />
        </DockPanel>
        <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                 AutomationProperties.Name="{app:Tr Export.Preview}" />
    </DockPanel>
</Window>
