<UserControl x:Class="PcToolkit.App.Views.PendingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:PcToolkit.App">
    <StackPanel Margin="8" MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
        <Border Style="{StaticResource Notice}">
            <StackPanel>
                <TextBlock Text="{Binding PhaseText}" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Body}" Text="{Binding Description}" />
                <TextBlock Style="{StaticResource Muted}" Text="{app:Tr Pending.NoSimulation}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
