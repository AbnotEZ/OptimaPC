<Window x:Class="PcToolkit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:PcToolkit.App"
        xmlns:vm="clr-namespace:PcToolkit.App.ViewModels"
        xmlns:v="clr-namespace:PcToolkit.App.Views"
        Title="{Binding Title}"
        Width="1180" Height="780" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><v:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MyPcViewModel}"><v:MyPcView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}"><v:DiagnosticsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><v:HistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PendingViewModel}"><v:PendingView /></DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="8,12,4,12">
            <TextBlock DockPanel.Dock="Bottom" Margin="12,8" Style="{StaticResource Muted}" FontSize="12"
                       Text="{app:Tr Nav.ReadOnlyNote}" MaxWidth="200" />
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                     AutomationProperties.Name="{app:Tr Nav.A11y}"
                     KeyboardNavigation.TabNavigation="Once" BorderThickness="0" Background="Transparent">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        <Setter Property="Padding" Value="12,9" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Text="{app:Tr Nav.PendingBadge}" Margin="8,0,0,0" Opacity="0.6" FontSize="11"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ContentControl Grid.Column="1" Content="{Binding Selected.Page}" Focusable="False" Margin="8,12,12,12" />
    </Grid>
</Window>
