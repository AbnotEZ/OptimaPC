<?xml version="1.0" encoding="utf-8"?>
<!--
  Publicación de versiones: ejecutable único, autocontenido (no requiere instalar .NET).
  Las bibliotecas nativas de WPF (firmadas por Microsoft) quedan junto al .exe en lugar de
  extraerse a %TEMP%; así solo hay que firmar OptimaPC.exe, que incluye nuestras DLL.
  Uso: dotnet publish src/PcToolkit.App -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <SatelliteResourceLanguages>en;es</SatelliteResourceLanguages>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
